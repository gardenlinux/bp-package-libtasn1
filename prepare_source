pkg=libtasn1-6
version_orig=4.21.0
version="${version_orig}-2"
version_suffix="gl1+bp1592"

git_src -b "${version}" https://salsa.debian.org/gnutls-team/libtasn1.git
git_src -b "v${version_orig}" https://gitlab.com/gnutls/libtasn1.git

apply_patches debian_fixes

apt-get install bison

# Bootstrap and repack original (Git) sources as they are modified by the script after checkout by intend and magic
pushd ${dir}/src

unlink ${dir}/orig.tar
./bootstrap --copy
tar -cf ../orig.tar .

popd
